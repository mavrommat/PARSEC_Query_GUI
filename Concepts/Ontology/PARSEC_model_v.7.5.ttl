PARSEC:P01_has_measurement a owl:ObjectProperty ;
    rdfs:comment "This property connects a celestial body to the measurements that have been calculated regarding it ." ;
    rdfs:domain PARSEC:E02_Celestial_Body ;
    rdfs:range PARSEC:E08_Measurement .

PARSEC:P02_has_value a owl:DatatypeProperty ;
    rdfs:comment "This property informs us of the value of a measurement." ;
    rdfs:domain PARSEC:E08_Measurement ;
    rdfs:range rdfs:Literal,
        xsd:double .

PARSEC:P03_has_unit a owl:ObjectProperty ;
    rdfs:comment "This property connects a data column with the measurement unit used to calculate its contained measurements." ;
    rdfs:domain PARSEC:E16_Data_Column ;
    rdfs:range xsd:string .

PARSEC:P04_contains_measurements_of_concept a owl:ObjectProperty ;
    rdfs:comment "This property connects a data column with its measurement classifications." ;
    rdfs:domain PARSEC:E16_Data_Column ;
    rdfs:range PARSEC:E11_Concept .

PARSEC:P12_has_identifier a owl:DatatypeProperty ;
    rdfs:domain PARSEC:E02_Celestial_Body ;
    rdfs:range rdfs:Literal .

PARSEC:P13_contains_data_source a owl:ObjectProperty ;
    rdfs:comment "This property connects a Data Source with another Data Source that is contained in the first one. (e.g. a paper contains a data table)" ;
    rdfs:domain PARSEC:E05_Data_Source ;
    rdfs:range PARSEC:E05_Data_Source .

PARSEC:P14_contains_celestial_body a owl:ObjectProperty ;
    rdfs:comment "This property connects a Celestial Body with another Celestial Body that is contained in the first one. (e.g. a galaxy contains a star)" ;
    rdfs:domain PARSEC:E02_Celestial_Body ;
    rdfs:range PARSEC:E02_Celestial_Body .

PARSEC:P21_is_measurement_from_column a owl:ObjectProperty ;
    rdfs:comment "This property connects a measurement with the Data Column it was extracted from." ;
    rdfs:domain PARSEC:E08_Measurement ;
    rdfs:range PARSEC:E16_Data_Column .

PARSEC:P23_has_magic_number_value a owl:DatatypeProperty ;
    rdfs:comment "This property informs us of a magic number value used in a Data Column." ;
    rdfs:domain PARSEC:E16_Data_Column ;
    rdfs:range rdfs:Literal .

PARSEC:P24_has_approval a owl:DatatypeProperty ;
    rdfs:comment "This property informs us of the approval status of a data column." ;
    rdfs:domain PARSEC:E16_Data_Column ;
    rdfs:range rdfs:Literal .

PARSEC:P32_is_connected_to_column a owl:ObjectProperty ;
    rdfs:comment "This property connects a column with a another column that has information about the first column." ;
    rdfs:domain PARSEC:E16_Data_Column ;
    rdfs:range PARSEC:E16_Data_Column .

PARSEC:P36_has_author a owl:DatatypeProperty ;
    rdfs:domain PARSEC:E05_Data_Source ;
    rdfs:range rdfs:Literal .

PARSEC:P39_has_URL a owl:DatatypeProperty ;
    rdfs:domain PARSEC:E05_Data_Source ;
    rdfs:range rdfs:Literal .

PARSEC:P46_originates_from_data_source a owl:ObjectProperty ;
    rdfs:comment "This property connects a measurement to the data source it originates from." ;
    rdfs:domain PARSEC:E08_Measurement ;
    rdfs:range PARSEC:E05_Data_Source .

PARSEC:P47_has_description a owl:DatatypeProperty ;
    rdfs:comment "This property connects to a literal description which may accompany a data column." ;
    rdfs:domain PARSEC:E16_Data_Column ;
    rdfs:range rdfs:Literal .

PARSEC:P48_belongs_in_measurement_category a owl:ObjectProperty ;
