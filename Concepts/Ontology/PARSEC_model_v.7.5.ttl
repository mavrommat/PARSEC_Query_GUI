unit:PER-CentiM2 a qudt:DerivedUnit,
        qudt:Unit,
        owl:NamedIndividual ;
    rdfs:label "Reciprocal Square Centimetre"@en,
        "Reciprocal Square Centimeter"@en-us ;
    qudt:conversionMultiplier 10000.0 ;
    qudt:conversionMultiplierSN 1e+04 ;
    qudt:hasFactorUnit [ a qudt:FactorUnit ;
            qudt:exponent -2 ;
            qudt:hasUnit unit:CentiM ] ;
    qudt:hasReciprocalUnit unit:CentiM2 ;
    qudt:scalingOf unit:PER-M2 ;
    qudt:symbol "/cm²" ;
    qudt:ucumCode "cm-2"^^qudt:UCUMcs ;
    PARSEC:P84_Astropy_Unit_Name "1 / cm2" .

